# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird NICHT committet.

# --- Allgemein -------------------------------------------------------------
# development | production (production erzwingt einen sicheren Secret Key, sichere Cookies und Security-Header)
SKYHOP_ENV=development
# Langer Zufallswert, z. B.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SKYHOP_SECRET_KEY=bitte-einen-langen-zufaelligen-wert-setzen
# Öffentliche Adresse der Seite (für Links in E-Mails und Stripe-Weiterleitungen)
BASE_URL=http://localhost:5000
# Hinter einem Reverse-Proxy (nginx, Caddy, Docker …) auf 1 setzen
TRUST_PROXY=0

# --- Datenbank ----------------------------------------------------------------
# Leer = SQLite in instance/skyhop.db
# Shared Hosting (MySQL/MariaDB aus dem Panel): mysql://BENUTZER:PASSWORT@localhost/DATENBANK
# PostgreSQL: postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANK
DATABASE_URL=

# --- Nur Docker (docker-compose.yml) ------------------------------------------
# Domain für automatisches HTTPS über Caddy; ohne Domain ":80" (Zugriff per http://<server-ip>)
DOMAIN=:80
POSTGRES_PASSWORD=

# --- E-Mail (SMTP) ---------------------------------------------------------
# Leer lassen = Mails werden nicht versendet, sondern unter /dev/mails angezeigt (Debug-Modus).
# Beispiele: Brevo smtp-relay.brevo.com:587, Mailjet in-v3.mailjet.com:587,
#            Postmark smtp.postmarkapp.com:587, lokal Mailpit localhost:1025 (MAIL_USE_TLS=0)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER=noreply@deine-domain.at
MAIL_REPLY_TO=support@deine-domain.at

# --- Zahlungen (Stripe Checkout) -------------------------------------------
# PayPal über Stripe: im Stripe-Dashboard unter Einstellungen → Zahlungsmethoden aktivieren (kein Code nötig).
# Sind weder Stripe noch PayPal konfiguriert = Demo-Zahlung. Testschlüssel beginnen mit sk_test_ (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Signing Secret des Webhook-Endpunkts <BASE_URL>/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Zahlungen (PayPal direkt, REST API v2) ---------------------------------
# Alternative oder Ergänzung zu Stripe. App anlegen unter https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (Test) oder live
PAYPAL_MODE=sandbox
# ID des Webhooks für <BASE_URL>/paypal/webhook (im PayPal-Developer-Dashboard anlegen)
PAYPAL_WEBHOOK_ID=

# Welche konfigurierten Anbieter angeboten werden und in welcher Reihenfolge (erster = vorausgewählt)
PAYMENT_PROVIDERS=stripe,paypal

# --- Auszahlungen an Pilot:innen ---------------------------------------------
# Über Stripe Connect (Express-Konten, Bankkonto) und/oder PayPal Payouts – je nachdem, was oben konfiguriert ist.
# Haltefrist nach dem Flug, bevor ausgezahlt wird (Stornos/Reklamationen):
PAYOUT_DELAY_HOURS=48
# Flüge, die die Pilot:in nicht selbst abschließt, werden so viele Stunden nach der Landung automatisch abgeschlossen:
AUTO_COMPLETE_HOURS=24

# --- Uploads ------------------------------------------------------------------
# Standard: instance/uploads. Lizenz-/Medical-Nachweise werden nie öffentlich ausgeliefert.
UPLOAD_FOLDER=
MAX_UPLOAD_MB=10
# Geprüfte Nachweise werden nach so vielen Tagen automatisch gelöscht (Datenminimierung, flask --app run cron)
DOCUMENT_RETENTION_DAYS=30

# --- Rechtstexte (Impressum, Datenschutz, AGB) --------------------------------
# Nicht gesetzte Felder erscheinen auf den Seiten gelb markiert als „[… ergänzen]“.
LEGAL_NAME=
# z. B. GmbH, e.U., Verein
LEGAL_FORM=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER=
LEGAL_REGISTER_COURT=
LEGAL_TRADE=
LEGAL_AUTHORITY=
LEGAL_CHAMBER=
LEGAL_PRIVACY_EMAIL=
# Datenschutzbeauftragte:r (falls bestellt)
LEGAL_DPO=
# z. B. "Hetzner Online GmbH, Gunzenhausen, Deutschland"
LEGAL_HOSTING=
# z. B. "Brevo (Sendinblue GmbH), Berlin, Deutschland"
LEGAL_MAIL_PROVIDER=
# Bei Änderungen der AGB hochzählen – gespeichert wird, welche Version jemand akzeptiert hat
TERMS_VERSION=2026-10
